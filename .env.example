# Copy this file to .env and set your real key
# PowerShell quick setup:
#   Copy-Item .env.example .env
#   (Get-Content .env) -replace 'YOUR_GROQ_API_KEY_HERE','gsk_xxx' | Set-Content .env

GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Optional fallback name supported by app.py:
# GROQ_API_TOKEN=YOUR_GROQ_API_KEY_HERE

GROQ_MODEL=llama-3.3-70b-versatile
